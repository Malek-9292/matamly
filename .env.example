# Copy to .env and replace every value. Do not put real passwords in this file.
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
CASHIER_PASSWORD=CHANGE_THIS_TO_A_DIFFERENT_LONG_PASSWORD
PRINT_AGENT_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_TOKEN
MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_A_LONG_DATABASE_PASSWORD
DATABASE_URL=mysql://root:CHANGE_THIS_TO_A_LONG_DATABASE_PASSWORD@127.0.0.1:3306/matamly
NODE_ENV=production
PORT=3000
# Optional import source. Used once, on the first startup, when the database is empty.
MATAMLY_DATA_FILE=./data/matamly.json
